<?xml version="1.0" encoding="utf-8"?>
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="OnRibbonLoad">
  <ribbon>
    <tabs>
      <tab id="LaTeXSnipperTab" getLabel="GetLabel" keytip="LS">
        <group id="FormulaGroup" getLabel="GetLabel">
          <button id="btnInsertDisplay" getLabel="GetLabel" getScreentip="GetScreentip" getSupertip="GetSupertip" keytip="D" size="large" imageMso="EquationInsertGallery" onAction="OnButtonClick" tag="insertDisplay" getEnabled="GetDesktopCommandEnabled"/>
          <box id="InsertVariantsBox" boxStyle="vertical">
            <button id="btnInsertInline" getLabel="GetLabel" getScreentip="GetScreentip" getSupertip="GetSupertip" keytip="I" imageMso="EquationProfessional" onAction="OnButtonClick" tag="insertInline" getEnabled="GetDesktopCommandEnabled"/>
            <button id="btnInsertNumbered" getLabel="GetLabel" getScreentip="GetScreentip" getSupertip="GetSupertip" keytip="N" imageMso="Numbering" onAction="OnButtonClick" tag="insertNumbered" getEnabled="GetDesktopCommandEnabled"/>
            <button id="btnOcrSelector" getLabel="GetLabel" getScreentip="GetScreentip" getSupertip="GetSupertip" keytip="O" imageMso="ScreenshotInsertGallery" onAction="OnButtonClick" tag="ocr" getEnabled="GetDesktopCommandEnabled"/>
          </box>
        </group>
        <group id="EditGroup" getLabel="GetLabel">
          <button id="btnLoadSelected" getLabel="GetLabel" getScreentip="GetScreentip" getSupertip="GetSupertip" keytip="E" size="large" imageMso="ReviewDisplayForReview" onAction="OnButtonClick" tag="readSelection"/>
          <button id="btnDeleteSelected" getLabel="GetLabel" getScreentip="GetScreentip" getSupertip="GetSupertip" keytip="X" imageMso="Delete" onAction="OnButtonClick" tag="delete"/>
        </group>
        <group id="ToolsGroup" getLabel="GetLabel">
          <button id="btnShowTaskPane" getLabel="GetLabel" getScreentip="GetScreentip" getSupertip="GetSupertip" keytip="P" size="large" imageMso="ReviewingPane" onAction="OnButtonClick" tag="showPane" getEnabled="GetDesktopCommandEnabled"/>
          <box id="WorkspaceActionsBox" boxStyle="vertical">
            <button id="btnSettings" getLabel="GetLabel" getScreentip="GetScreentip" getSupertip="GetSupertip" keytip="S" imageMso="AdvancedFileProperties" onAction="OnButtonClick" tag="settings" getEnabled="GetDesktopCommandEnabled"/>
            <button id="btnHelp" getLabel="GetLabel" getScreentip="GetScreentip" getSupertip="GetSupertip" keytip="H" imageMso="Help" onAction="OnButtonClick" tag="help"/>
          </box>
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
